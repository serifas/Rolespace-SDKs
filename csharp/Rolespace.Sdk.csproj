<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Rolespace.Sdk</RootNamespace>

        <!-- NuGet package metadata -->
        <PackageId>Rolespace.Sdk</PackageId>
        <Version>0.2.0</Version>
        <Authors>Rolespace</Authors>
        <Company>Rolespace</Company>
        <Description>Official Rolespace bot SDK for .NET. Bearer-token client with built-in 429 retry, an interactions IAsyncEnumerable, and constant-time webhook signature verification.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>rolespace;bot;sdk;chat;api;webhook</PackageTags>
        <PackageProjectUrl>https://github.com/rolespace/rolespace-sdks/tree/main/csharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/rolespace/rolespace-sdks</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- NU5125 / NU5048: noisy warnings from the metadata above; keep XML doc warnings visible. -->
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Source Link so consumers can debug into the SDK directly from NuGet. -->
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>
</Project>
